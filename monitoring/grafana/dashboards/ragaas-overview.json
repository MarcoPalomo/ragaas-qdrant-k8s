      "id": 6,
      "title": "Total Vectors",
      "type": "stat",
      "targets": [{"expr": "sum(qdrant_collection_points_count)", "legendFormat": ""}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
